{
  "_comment": "TIER 2: Experiment stage overrides. Inherits from pipeline_config.json. Only specify differences.",
  
  "paths": {
    "design_execution_root": "./results/${dataset_name}/generate_execution"
  },
  
  "llm": {
    "model": "gemini-3-pro-all",
    "temperature": 0.5
  },
  
  "experiment": {
    "primary_metric": "PCC",
    "max_iterations": 3,
    "success_threshold": 0.5
  },
  
  "prompt_branch": {
    "output_type": "notebook",
    "prompt_file": "prompts/pipeline_prompt.yaml",
    "idea_file": "idea.json",
    "save_root": "./results/${dataset_name}/generate_execution",
    "temperature": 0.7,
    "max_tokens": 40000
  },
  
  "exec": {
    "timeout_seconds": 360000,
    "enable_hypergraph_viz": true,
    "viz_format": "mermaid",
    "cuda_device_id": 3
  }
}