{
  "_comment": "TIER 3: Review stage overrides. Inherits from pipeline_config.json. Only specify differences.",
  "paths": {
    "generate_execution_root": "./results/${dataset_name}/generate_execution",
    "review_feedback_root": "./results/${dataset_name}/review_feedback",
    "explicit_source_path": null
  },
  "llm": {
    "model": "gemini-3-pro-all",
    "temperature": 0.7
  },
  "review": {
    "target_metric": "PCC",
    "direction": "maximize",
    "max_iterations": 10,
    "pass_threshold": 0.7,
    "force_cells": [
      0,
      1,
      4
    ],
    "protected_sections": [
      "SECTION 1",
      "SECTION 2",
      "Data Loading",
      "Evaluation"
    ],
    "target_sections": [
      "SECTION 3",
      "Innovation",
      "Modeling",
      "Training"
    ],
    "optimization_hierarchy": [
      "1. Model Architecture (Backbone/Encoder)",
      "2. Data Fusion Mechanism (Interaction/Attention)",
      "3. Loss Function & Optimization Strategy"
    ],
    "new_hypothesis_rejection_threshold": 3,
    "routing_policy": {
      "prefer_modeling_until_iteration": 2,
      "max_research_hops": 1
    }
  },
  "exec": {
    "timeout_seconds": 18000
  },
  "literature": {
    "bio_kb": {
      "_comment": "Review stage: more aggressive BioKB querying for optimization",
      "inject_max_items": 8,
      "max_targets_per_smiles": 10,
      "max_pathways_per_target": 15
    }
  }
}
